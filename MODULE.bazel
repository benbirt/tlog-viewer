module(
    name = "tlog_viewer",
    version = "0.0.0",
)

bazel_dep(name = "aspect_rules_esbuild", version = "0.27.1")
bazel_dep(name = "aspect_rules_js", version = "3.6.0")
bazel_dep(name = "aspect_rules_ts", version = "3.10.1")
bazel_dep(name = "bazel_lib", version = "3.8.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_go", version = "0.65.0")
bazel_dep(name = "rules_nodejs", version = "6.7.7")

# The tlog-policy (log keys, witness keys and quorum) baked into the viewer is
# built from this repository. It is not in a registry, so it is pinned by
# commit; .github/workflows/update-pins.yaml advances the pin.
bazel_dep(name = "google-tlog-witness", version = "0.0.1", repo_name = "google_tlog_witness")
git_override(
    module_name = "google-tlog-witness",
    commit = "8b7a0ed2a5727ad9bc47da4594f4b41078408c45",
    remote = "https://github.com/google/google-tlog-witness.git",
)

# Tests run the verifier under Node's WebCrypto; ML-DSA needs Node >= 24.7.
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node", dev_dependency = True)
node.toolchain(node_version = "24.22.1")

# pnpm, run through Bazel to change dependencies:
#   bazel run -- @pnpm//:pnpm --dir $PWD add --save-dev --save-exact --lockfile-only <package>
pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm", dev_dependency = True)
pnpm.pnpm(pnpm_version_from = "//:package.json")
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm", dev_dependency = True)
npm.npm_translate_lock(
    name = "npm",
    pnpm_lock = "//:pnpm-lock.yaml",
)

# rules_js drops documentation from packages, licences included. Keep the
# whole of the packages whose code the site ships, so that their licences can
# be served with it (//:licenses).
[
    npm.npm_exclude_package_contents(
        package = package,
        presets = [],
    )
    for package in [
        "@noble/curves",
        "@noble/hashes",
        "jose",
    ]
]
use_repo(npm, "npm")

typescript = use_extension("@aspect_rules_ts//ts:extensions.bzl", "typescript", dev_dependency = True)
typescript.deps(version_from = "//:package.json")
use_repo(typescript, "npm_typescript")

# Go is what the page verifies with: //verifier is the Go implementations of
# the transparency formats, compiled to WebAssembly.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk.from_file(
    name = "go_sdk",
    go_mod = "//:go.mod",
)
use_repo(go_sdk, "go_sdk")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_transparency_dev_formats",
    "org_golang_x_mod",
)

# TinyGo builds the module the site ships. Its rules are not in a
# registry, so they are pinned by commit, which update-pins.yaml advances. The
# pin is to a fork's hermetic-embed branch, which builds go_library targets
# with no network access; return to ptxmac/rules_tinygo once it has that.
bazel_dep(name = "rules_tinygo", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "rules_tinygo",
    commit = "5be0db528125a42e1a46e9e62c724c9e799217ff",
    remote = "https://github.com/benbirt/rules_tinygo.git",
)
