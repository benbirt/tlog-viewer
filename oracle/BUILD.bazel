load("@rules_go//go:def.bzl", "go_binary")

# The Go implementations of the transparency formats as a WebAssembly module,
# for the differential tests in //:tests/oracle. See main.go.
package(default_visibility = ["//:__pkg__"])

# Built with the Go compiler.
go_binary(
    name = "oracle_go",
    srcs = ["main.go"],
    out = "oracle_go.wasm",
    gc_linkopts = [
        "-s",
        "-w",
    ],
    goarch = "wasm",
    goos = "js",
    pure = "on",
    deps = [
        "@com_github_transparency_dev_formats//log",
        "@com_github_transparency_dev_formats//policy",
        "@com_github_transparency_dev_formats//proof",
        "@org_golang_x_mod//sumdb/note",
        "@org_golang_x_mod//sumdb/tlog",
    ],
)

# The JavaScript half of Go's WebAssembly runtime, from the Go SDK.
genrule(
    name = "go_wasm_exec",
    outs = ["go_wasm_exec.js"],
    srcs = ["@go_sdk//:lib/wasm/wasm_exec.js"],
    cmd = "cp $< $@",
)

# Built with TinyGo, from the same source: a quarter of the size. TinyGo
# resolves the Go modules itself, so this build fetches them (go.sum pins
# what it gets) and is not hermetic. Its scratch files go in the sandbox's
# own directory, which Bazel discards.
genrule(
    name = "oracle_tinygo",
    srcs = [
        "main.go",
        "//:go.mod",
        "//:go.sum",
    ],
    outs = ["oracle_tinygo.wasm"],
    cmd = """
        set -eu
        work=$$PWD/tinygo_work
        goroot=$$PWD/$$(dirname $$(dirname $(execpath @go_sdk//:bin/go)))
        mkdir -p "$$work/src/oracle"
        cp $(location //:go.mod) $(location //:go.sum) "$$work/src/"
        cp $(location main.go) "$$work/src/oracle/"
        tinygo=$$PWD/$(execpath @tinygo_linux_amd64//:bin/tinygo)
        out=$$PWD/$@
        cd "$$work/src"
        HOME="$$work" GOROOT="$$goroot" PATH="$$goroot/bin:$$PATH" GOMODCACHE="$$work/mod" GOCACHE="$$work/cache" GOFLAGS=-mod=mod \\
            "$$tinygo" build -target wasm -no-debug -o "$$out" ./oracle
    """,
    tags = ["requires-network"],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    tools = [
        "@go_sdk//:bin/go",
        "@go_sdk//:files",
        "@tinygo_linux_amd64//:bin/tinygo",
        "@tinygo_linux_amd64//:files",
    ],
)

# TinyGo's own JavaScript runtime, which differs from Go's.
genrule(
    name = "tinygo_wasm_exec",
    srcs = ["@tinygo_linux_amd64//:targets/wasm_exec.js"],
    outs = ["tinygo_wasm_exec.js"],
    cmd = "cp $< $@",
)
