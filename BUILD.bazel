load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_binary", "js_run_binary", "js_test")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config", "ts_project")
load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@npm//:defs.bzl", "npm_link_all_packages")

npm_link_all_packages(name = "node_modules")

# Browser code.
ts_config(
    name = "tsconfig",
    src = "tsconfig.json",
)

# Node code: tests and tools.
ts_config(
    name = "tsconfig_node",
    src = "tsconfig.node.json",
    deps = [":tsconfig"],
)

# The viewer. web/js/policy_data.d.ts stands in for the generated policy
# module below, so that compiling does not depend on generating it.
ts_project(
    name = "web",
    srcs = glob(["web/js/*.ts"]),
    declaration = True,
    tsconfig = ":tsconfig",
    deps = [
        ":node_modules/@noble/curves",
        ":node_modules/jose",
    ],
)

ts_project(
    name = "node",
    srcs = glob([
        "tests/*.ts",
        "tests/e2e/*.ts",
        "tests/verifier/*.ts",
        "tools/*.ts",
    ]),
    declaration = True,
    tsconfig = ":tsconfig_node",
    deps = [
        ":node_modules/@types/node",
        ":node_modules/playwright-core",
        ":web",
    ],
)

NODE_RUNTIME = [
    "package.json",
    ":node",
    ":web",
]

# The verifier policy for the production PAIC logs, from google-tlog-witness.
copy_file(
    name = "policy_file",
    src = "@google_tlog_witness//policies/paic:prod-verifier.policy",
    out = "prod-verifier.policy",
)

js_binary(
    name = "gen_policy",
    data = NODE_RUNTIME,
    entry_point = "tools/gen_policy.js",
)

# Bakes the policy into a JS module, failing the build if the verifier the
# page will read it with rejects it.
js_run_binary(
    name = "policy_data",
    srcs = [
        "MODULE.bazel",
        ":prod-verifier.policy",
        "//verifier:tinygo_wasm_exec",
        "//verifier:verifier_tinygo",
    ],
    args = [
        "prod-verifier.policy",
        "MODULE.bazel",
        "$(rootpath //verifier:verifier_tinygo)",
        "$(rootpath //verifier:tinygo_wasm_exec)",
    ],
    stdout = "web/js/policy_data.js",
    tool = ":gen_policy",
)

js_binary(
    name = "gen_build_info",
    data = NODE_RUNTIME,
    entry_point = "tools/gen_build_info.js",
)

# Says which commit the site was built from, in builds made with
# --config=release; otherwise that it is a development build.
js_run_binary(
    name = "build_info",
    stamp = -1,
    stdout = "web/js/build_info.js",
    tool = ":gen_build_info",
)

# The one module of the site that is bundled: web/js/deps.ts with the
# third-party code it imports, as a single file the others import like any
# other. Not minified, so that it can be read.
esbuild(
    name = "deps_bundle",
    srcs = ["web/js/deps.ts"],
    entry_point = "web/js/deps.ts",
    format = "esm",
    output = "web/bundled/deps.js",
    platform = "browser",
    sourcemap = "",
    target = "es2022",
    deps = [
        ":node_modules/@noble/curves",
        ":node_modules/jose",
    ],
)

js_binary(
    name = "gen_licenses",
    data = NODE_RUNTIME + [
        ":node_modules/@noble/curves",
        ":node_modules/jose",
    ],
    entry_point = "tools/gen_licenses.js",
)

# The licences of the third-party code in the bundle, served beside it.
js_run_binary(
    name = "licenses",
    srcs = [":deps_bundle"],
    args = ["web/bundled/deps.js"],
    stdout = "web/third-party-licenses.txt",
    tool = ":gen_licenses",
)

# The static site, ready to serve from any web server.
copy_to_directory(
    name = "site",
    srcs = [
        "web/index.html",
        "web/style.css",
        ":build_info",
        ":deps_bundle",
        ":licenses",
        ":policy_data",
        ":web",
        # The verifier: the Go implementations of the transparency formats
        # as WebAssembly, the script that runs it, and their licences.
        "//verifier:notices",
        "//verifier:tinygo_wasm_exec",
        "//verifier:verifier_tinygo",
    ],
    # tsc's own deps.js, with its bare imports, gives way to the bundle.
    exclude_srcs_patterns = [
        "**/*.d.ts",
        "**/js/deps.js",
    ],
    replace_prefixes = {
        "bundled": "js",
        "verifier": "wasm",
    },
    root_paths = ["web"],
)

# bazel run //:serve [-- port]
js_binary(
    name = "serve",
    data = NODE_RUNTIME + [":site"],
    entry_point = "tools/serve.js",
)

[
    js_test(
        name = t.removeprefix("tests/").removesuffix(".ts").replace(".", "_"),
        size = "small",
        data = NODE_RUNTIME + glob(["tests/testdata/**"]) + [
            ":build_info",
            ":policy_data",
            ":site",
        ],
        entry_point = t.removesuffix(".ts") + ".js",
    )
    for t in glob(["tests/*.test.ts"])
]

# The built site in a real browser, against logs made up for the purpose
# (tests/e2e/testlog.ts). Needs Chrome on the machine: see chromePath() in
# tests/e2e/harness.ts. Nothing is fetched from the network.
js_test(
    name = "e2e_test",
    size = "medium",
    data = NODE_RUNTIME + [
        ":node_modules/playwright-core",
        ":site",
    ],
    entry_point = "tests/e2e/viewer.e2e.js",
    # Chrome expects a home directory it can write to.
    env = {
        "HOME": "/tmp",
    },
)

# The verifier as TinyGo builds it for the site against the same source built
# by the Go compiler: tests/verifier/agreement.ts.
js_test(
    name = "verifier_agreement_test",
    size = "medium",
    data = NODE_RUNTIME + glob(["tests/testdata/**"]) + [
        ":build_info",
        ":policy_data",
        "//verifier:go_wasm_exec",
        "//verifier:tinygo_wasm_exec",
        "//verifier:verifier_go",
        "//verifier:verifier_tinygo",
    ],
    entry_point = "tests/verifier/agreement.js",
    env = {
        "VERIFIER_GO_EXEC": "$(rootpath //verifier:go_wasm_exec)",
        "VERIFIER_GO_WASM": "$(rootpath //verifier:verifier_go)",
        "VERIFIER_TINYGO_EXEC": "$(rootpath //verifier:tinygo_wasm_exec)",
        "VERIFIER_TINYGO_WASM": "$(rootpath //verifier:verifier_tinygo)",
    },
)
